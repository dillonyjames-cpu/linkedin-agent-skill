<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs imessage_sync.py every hour. install.sh fills in the two paths and
  copies this file to ~/Library/LaunchAgents/.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hackathon-monitor.imessage-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__DIR__/imessage_sync.py</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__DIR__/sync.log</string>
  <key>StandardErrorPath</key>
  <string>__DIR__/sync.log</string>
</dict>
</plist>
